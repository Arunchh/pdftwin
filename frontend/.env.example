# Copy to frontend/.env for local development
# Full setup guide: docs/product/supabase-auth.md

# Auth provider: mock | supabase
VITE_AUTH_PROVIDER=supabase

# Supabase — PDF Twin project (Dashboard → Settings → API)
VITE_SUPABASE_URL=https://tcwvrdykeojriwsxglbn.supabase.co
VITE_SUPABASE_ANON_KEY=

# Billing: mock | paypal
VITE_BILLING_PROVIDER=mock

# Set true when backend PayPal billing is wired up
VITE_CHECKOUT_LIVE=false

# On Vercel: set the same VITE_* vars under Project → Environment Variables,
# then redeploy. Values are baked in at build time and injected into pages
# as window.__PDFTWIN_ENV__ for client-side auth islands.
