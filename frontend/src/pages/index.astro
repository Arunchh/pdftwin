---
import BaseLayout from "../layouts/BaseLayout.astro";
import HeroSection from "../components/layout/HeroSection";
import HomeWorkflowSection from "../components/layout/HomeWorkflowSection";
import HomeToolsSection from "../components/layout/HomeToolsSection";
import { getMessages } from "../i18n/utils";

const messages = getMessages("en");
---

<BaseLayout locale="en" title={messages.meta.homeTitle} description={messages.meta.homeDescription}>
  <HeroSection client:visible />
  <HomeWorkflowSection client:visible />
  <HomeToolsSection client:visible />
</BaseLayout>
