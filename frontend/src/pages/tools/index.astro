---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ToolsIndexPage from "../../components/content/ToolsIndexPage";
import { TOOLS, toolPath } from "../../config/tools";
import { getMessages } from "../../i18n/utils";

const messages = getMessages("en");
const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "PDFTwin", item: "https://pdftwin.com/" },
        {
          "@type": "ListItem",
          position: 2,
          name: messages.toolsIndex.breadcrumb,
          item: "https://pdftwin.com/tools/",
        },
      ],
    },
    {
      "@type": "ItemList",
      name: messages.toolsIndex.heading,
      description: messages.toolsIndex.subheading,
      numberOfItems: TOOLS.length,
      itemListElement: TOOLS.map((tool, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: messages.tools[tool.id].name,
        url: `https://pdftwin.com${toolPath(tool.id, "en")}`,
      })),
    },
  ],
};
---

<BaseLayout
  locale="en"
  title={messages.meta.toolsIndexTitle}
  description={messages.meta.toolsIndexDescription}
  structuredData={structuredData}
>
  <ToolsIndexPage client:load />
</BaseLayout>
